          "name": "amount",
          "type": "numeric(10, 2)",
          "primaryKey": false,
          "notNull": true
        }
      },
      "definition": "select \"fee_records\".\"id\", \"fee_records\".\"student_id\", \"fee_records\".\"term_id\", \"fee_records\".\"class_id\", \"class_term_fees\".\"amount\", coalesce(sum(\"fee_payments\".\"amount\"), 0) as \"amount_paid\", \"class_term_fees\".\"amount\" - coalesce(sum(\"fee_payments\".\"amount\"), 0) as \"amount_due\" from \"fee_records\" inner join \"class_term_fees\" on (\"class_term_fees\".\"term_id\" = \"fee_records\".\"term_id\" and \"class_term_fees\".\"class_id\" = \"fee_records\".\"class_id\") left join \"fee_payments\" on \"fee_payments\".\"fee_record_id\" = \"fee_records\".\"id\" group by \"fee_records\".\"id\", \"class_term_fees\".\"amount\"",
      "name": "fee_balances",
      "schema": "public",
      "isExisting": false,
      "with": {
        "securityInvoker": true
      },
      "materialized": false
    }
  },
